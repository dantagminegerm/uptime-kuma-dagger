# Local defaults for the Dagger module (https://docs.dagger.io/features/local-defaults).
# This file holds NO secret values — only references to secret providers.
# Keys are argument names matched case-insensitively (camelCase, no underscores:
# an underscore separates FUNCTION_ARG). CLI flags override everything here,
# e.g.  dagger call --grafana-password=env://GF_PASS deploy-monitoring

# Host Docker daemon socket, proxied into Dagger containers.
SOCK=/var/run/docker.sock

# Host endpoints used by configure-grafana / validate (tunnelled from the host into Dagger).
GRAFANA=tcp://localhost:3000
PROMETHEUS=tcp://localhost:9090
UptimeKuma=tcp://localhost:3001

# Secrets: generated on first use into ./.secrets (git-ignored, mode 0600).
DbRootPassword=cmd://"sh scripts/secret.sh mariadb_root_password"
DbPassword=cmd://"sh scripts/secret.sh mariadb_password"
DbExporterPassword=cmd://"sh scripts/secret.sh mariadb_exporter_password"
GrafanaPassword=cmd://"sh scripts/secret.sh grafana_admin_password"
