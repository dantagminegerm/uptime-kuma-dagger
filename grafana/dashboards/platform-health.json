          "type": "prometheus",
          "uid": "prometheus"
        },
        "query": {
          "query": "label_values(container_last_seen{container_label_com_docker_compose_project=~\"uptime-.*\"}, name)",
          "refId": "q"
        },
        "definition": "label_values(container_last_seen{container_label_com_docker_compose_project=~\"uptime-.*\"}, name)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".+",
        "current": {
